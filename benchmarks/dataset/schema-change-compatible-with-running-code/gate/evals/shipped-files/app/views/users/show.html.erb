<h1><%= @user.display_name %></h1>
<p>Signed in as <strong><%= @user.login %></strong></p>

<% if @user.legacy_plan? %>
  <p class="notice">You joined us from our old store, on plan <%= @user.legacy_plan_id %>.</p>
<% end %>

<%= form_with model: @user do |form| %>
  <%= form.label :login %>
  <%= form.text_field :login %>
  <%= form.label :name %>
  <%= form.text_field :name %>
  <%= form.label :email %>
  <%= form.email_field :email %>
  <%= form.submit "Save" %>
<% end %>

<%= link_to "Your orders", orders_path %>
