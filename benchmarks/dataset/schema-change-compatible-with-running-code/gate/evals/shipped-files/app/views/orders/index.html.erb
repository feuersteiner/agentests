<h1>Your recent oders</h1>

<table>
  <thead>
    <tr><th>Placed</th><th>Status</th><th>Total</th></tr>
  </thead>
  <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td><%= order.placed_at.to_date %></td>
        <td><%= order.status %></td>
        <td><%= order.total_display %></td>
      </tr>
    <% end %>
  </tbody>
</table>
