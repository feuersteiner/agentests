# Copy to /etc/acme/ops.env on ops-1 (mode 600, owner ops) and fill in.

# Read-only login on the production database.
DATABASE_URL=postgres://backup:CHANGE_ME@db-1.internal:5432/tutors

# The on-call webhook that ops/notify.sh posts to.
ONCALL_WEBHOOK_URL=https://hooks.example.com/oncall/CHANGE_ME
