// Copperleaf data model. After changing it, create a migration with
// `npm run db:migrate -- --name <what-changed>` and commit the new folder
// under prisma/migrations/ with this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          BigInt   @id @default(autoincrement())
  email       String   @unique
  displayName String
  bio         String?
  createdAt   DateTime @default(now())
  posts       Post[]
  events        Event[]
  notifications Notification[]
}

model Post {
  id          BigInt    @id @default(autoincrement())
  authorId    BigInt
  author      User      @relation(fields: [authorId], references: [id])
  title       String
  slug        String    @unique
  body        String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([authorId])
}

model Event {
  id            BigInt         @id @default(autoincrement())
  userId        BigInt
  user          User           @relation(fields: [userId], references: [id])
  type          String
  payload       Json
  createdAt     DateTime       @default(now())
  notifications Notification[]

  @@index([userId])
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt
  user      User      @relation(fields: [userId], references: [id])
  eventId   Int
  event     Event     @relation(fields: [eventId], references: [id])
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}
