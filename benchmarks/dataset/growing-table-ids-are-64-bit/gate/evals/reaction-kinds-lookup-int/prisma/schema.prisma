// Copperleaf data model. After changing it, create a migration with
// `npm run db:migrate -- --name <what-changed>` and commit the new folder
// under prisma/migrations/ with this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          BigInt   @id @default(autoincrement())
  email       String   @unique
  displayName String
  bio         String?
  createdAt   DateTime @default(now())
  posts       Post[]
  messages    Message[]  @relation("SentMessages")
  reactions   Reaction[]
}

model Post {
  id          BigInt    @id @default(autoincrement())
  authorId    BigInt
  author      User      @relation(fields: [authorId], references: [id])
  title       String
  slug        String    @unique
  body        String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([authorId])
}

model Message {
  id        BigInt     @id @default(autoincrement())
  senderId  BigInt
  sender    User       @relation("SentMessages", fields: [senderId], references: [id])
  body      String
  createdAt DateTime   @default(now())
  reactions Reaction[]

  @@index([senderId, createdAt])
}

/// The fixed set of reactions members can pick from. The team adds a
/// new kind by hand in a migration, a few times a year at most.
model ReactionKind {
  id        Int        @id
  emoji     String     @unique
  label     String
  reactions Reaction[]
}

model Reaction {
  id        BigInt       @id @default(autoincrement())
  messageId BigInt
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    BigInt
  user      User         @relation(fields: [userId], references: [id])
  kindId    Int
  kind      ReactionKind @relation(fields: [kindId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([messageId, userId, kindId])
}
