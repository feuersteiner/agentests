+	const pending: string[] = [];
+	const agentBody = (who: Who, paragraphs: string[], more = false) => {
+		const extra = who === 'a' ? pending.splice(0) : [];
+		if (extra.some((text) => asideReplies.some((intro) => text.startsWith(intro)))) asideDelivered = true;
+		const closing = more && r() < 0.4 ? [pick(r, closings)] : [];
+		const hello = /^(Hello|Hi) /.test(paragraphs[0]!) || paragraphs[0]!.slice(0, 30).includes(person.first) ? [] : [pick(r, [`Hi ${person.first},`, `Hello ${person.first},`, `Hi ${person.first},`])];
+		return [...hello, ...paragraphs, ...extra, ...closing, fill(pick(r, who === 'a' ? agentSign : ['Thanks,\n{signer}', 'Best,\n{signer}', '{signer}']), { signer: signers[who] ?? agent })].join('\n\n');
+	};
+
+	// 1. The customer writes in.
+	const opening: string[] = [];
+	const introduced = r() < 0.65;
+	if (introduced) opening.push(fill(pick(r, intros)));
+	opening.push(fill(pick(r, path.open ?? topic.open)));
+	if (introduced && r() < 0.75) opening.push(pick(r, integration.setup));
+	if (r() < 0.4) opening.push(fill(pick(r, situations)));
+	const more = r() < 0.8 ? fill(pick(r, topic.more)) : '';
+	if (more) opening.push(more);
+	if (topic.shows && r() < 0.85) {
+		if (!more.endsWith(':') && !/below\.$/.test(more)) opening.push(pick(r, pasteIntros));
+		opening.push(pasteOf(topic.shows, t));
+	}
+	say('c', custBody(opening, true));
+	if (topic.usage && r() < 0.5) {
+		advance('n');
+		say('n', `${pick(r, usageNotes)}\n\n${pasteOf('usage', t)}`);
+	}
+
+	// 2. Support asks.
+	advance('a');
+	const ask = fill(pick(r, topic.ask));
+	const ack = /^(Thanks|Sorry|No problem)/.test(ask) ? '' : pick(r, acks);
+	say('a', agentBody('a', [[ack, ask].filter(Boolean).join(' ')], true));
+
+	// 3. The customer answers, and may raise a second matter.
+	advance('c');
+	const side = r() < (aside ? 0.35 : 0.6) ? pick(r, sides) : undefined;
+	const answer = [fill(pick(r, path.detail)), pasteOf(path.paste, t)];
+	const code = path.bare || !pagingKinds.includes(c.kind) ? '' : pasteOf('code', t);
+	if (code && r() < (path.paste ? 0.4 : 0.85)) answer.push(pick(r, codeIntros), code);
+	else if (!path.paste && !path.bare && topic.sample && r() < 0.55) answer.push(pick(r, pasteIntros), pasteOf(topic.sample, t));
+	if (aside) {
+		const [other, otherPath] = aside;
+		const variant = otherPath.ends[0]!;
+		const reply = variant.find(([who]) => who === 'a')![1];
+		const thanks = variant.slice(variant.findIndex(([who]) => who === 'a')).find(([who]) => who === 'c');
+		answer.push(pick(r, asideIntros), fill(pick(r, otherPath.open ?? other.open), v2), fill(pick(r, otherPath.detail), v2), pasteOf2(otherPath.paste ?? other.shows, t));
+		pending.push(`${pick(r, asideReplies)}\n\n${fill(reply, v2)}`);
+		if (thanks) asideThanksText = `${pick(r, asideThanks)} ${fill(thanks[1], v2)}`;
+	}
+	if (side) {
+		answer.push(fill(side.q));
+		pending.push(fill(side.a));
+	}
+	say('c', custBody(answer, false));
+
+	// 4. Someone looks.
+	const lookWho = path.lookWho ?? 'n';
+	if (lookWho === 'd' && r() < 0.45) {
+		advance('n');
+		say('n', fill(pick(r, forwards)));
+	}
+	advance(lookWho);
+	say(lookWho, [fill(pick(r, path.look)), pasteOf(path.lookPaste, t)].filter(Boolean).join('\n\n'));
+	if (aside && r() < 0.6) {
+		const otherWho = aside[1].lookWho === 'd' ? 'n' : aside[1].lookWho ?? 'n';
+		advance(otherWho);
+		say(otherWho, [`Second matter: ${fill(pick(r, aside[1].look), v2)}`, pasteOf2(aside[1].lookPaste, t)].filter(Boolean).join('\n\n'));
+	}
+
+	// 5. Sometimes a wait; always when the second matter would otherwise go unanswered.
+	const end = pick(r, path.ends);
+	const answered = end.some(([who]) => who === 'a');
+	const second = shuffle(r, sides).find((other) => other !== side)!;
+	const chase = () => {
+		advance('c');
+		const raise = answered && r() < 0.5;
+		say('c', custBody([fill(pick(r, chasers)), ...(raise ? [fill(second.q)] : [])], false));
+		if (raise) pending.push(fill(second.a));
+	};
+	if ((path.team && lookWho !== 'n' && r() < 0.6) || (pending.length && !answered)) {
+		advance('a');
+		held = true;
+		say('a', agentBody('a', [fill(pick(r, holding))], true));
+		if (r() < 0.5) chase();
+	} else if (r() < 0.3) chase();
+
+	// 6. The end.
+	const thanks = side?.then && r() < 0.6 ? fill(side.then) : '';
+	/** The help desk's own messages come days later, and none is sent after the export. */
+	const tooLate = () => office(r, startOfDay(t) + 5 * DAY + 9 * 60) > LAST_MESSAGE;
+	end.forEach(([who, body], i) => {
+		if (who === 's' && tooLate()) return;
+		advance(who);
+		const text = fill(body);
+		if (who === 'c') say('c', custBody(i === end.length - 1 && thanks ? [text, thanks] : [text], false));
+		else if (who === 'a' || signers[who]) say(who, agentBody(who, [text]));
+		else say(who, text);
+	});
+	if (path.happy && r() < 0.45 && !tooLate()) {
+		advance('s');
+		const [rating, comment] = pick(r, surveys);
+		say('s', `Satisfaction survey answered: ${rating}.${comment ? ` “${fill(comment)}”` : ''}`);
+	}
+
+	const subject = aside && r() < 0.25 ? fill(pick(r, aside[1].subjects ?? aside[0].subjects), v2) : fill(pick(r, path.subjects ?? topic.subjects));
+	const channel = r() < 0.7 ? 'by email' : 'through the developer portal form';
+	const older = h % 3 === 0 ? [4700 + (h % 480)] : [];
+	const panel = [`| Account | ${company.name} |`, '| --- | --- |', `| Plan | ${company.plan}, ${seats} seats |`, `| Customer since | ${monthNames[h % 12]} ${2021 + (h % 5)} |`, `| Projects | ${count} |`, `| API tokens | ${1 + (h % 5)} active |`, `| Earlier developer tickets | ${[...older, ...earlier].map((n) => `#${n}`).join(', ') || 'none'} |`].join('\n');
+	return [`# Ticket ${number}: ${subject}`, `From ${full} <${email}>, ${company.name} · ${stampLong(open)} · ${channel}`, panel, ...messages.map((message) => `---\n\n${message}`)].join('\n\n') + '\n';
+};
+
+// ---------------------------------------------------------------------------------------------------------
+// Which topic and path each ticket follows. Each ticket takes the least-used topic that fits its day, in an order
+// shuffled anew for each round, and the paths of a topic in turn, so that two tickets on one topic end differently.
+const order = mulberry32(20261001);
+const used = new Map<Topic, number>(topics.map((topic) => [topic, 0]));
+let rank = new Map(shuffle(order, topics).map((topic, i) => [topic, i]));
+let round = 0;
+const plans: Plan[] = [];
+for (let index = 0; index < ITEMS; index++) {
+	const day = workdays[Math.floor((index * workdays.length) / ITEMS)]!;
+	const allowed = topics.filter((topic) => (topic.since ?? -Infinity) <= day && (topic.until ?? Infinity) >= day);
+	const topic = allowed.reduce((best, item) => (used.get(item)! * 1000 + rank.get(item)! < used.get(best)! * 1000 + rank.get(best)! ? item : best));
+	const seen = used.get(topic)!;
+	used.set(topic, seen + 1);
+	const lowest = Math.min(...[...used.values()]);
+	if (lowest > round) {
+		round = lowest;
+		rank = new Map(shuffle(order, topics).map((item, i) => [item, i]));
+	}
+	const company = companies[Math.floor(mulberry32(31 + index * 104729)() * companies.length)]!;
+	plans.push({ topic, path: topic.paths[(seen + topics.indexOf(topic)) % topic.paths.length]!, day, company });
+}
+
+const folder = join(root, 'support', 'api-tickets');
+mkdirSync(folder, { recursive: true });
+let number = 5210;
+const history = new Map<Company, number[]>();
+plans.forEach((plan, index) => {
+	number += int(order, 1, 3);
+	const earlier = history.get(plan.company) ?? [];
+	writeFileSync(join(folder, `ticket-${number}.md`), ticket(index, plan, number, earlier.slice(-4)));
+	history.set(plan.company, [...earlier, number]);
+});
+writeFileSync(
+	join(folder, 'README.md'),
+	`# Developer support tickets, 1 October to 13 November 2026\n\nThe ${ITEMS} tickets the developer support desk handled in these six weeks, one file each, exported from the\nhelp desk on 20 November. The export kept the messages and internal notes but not the tags, statuses or\nassignees. Numbers missing from the sequence were spam or were merged into another ticket. Tokens in pasted\noutput were cut short by support; gateway and admin-tool extracts in internal notes are as pasted.\n`
+);
