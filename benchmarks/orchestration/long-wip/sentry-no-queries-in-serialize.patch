+}
+const nameOf = (slug: string) =>
+	slug
+		.split('-')
+		.map((word) => ({ ios: 'iOS', api: 'API', sdk: 'SDK', sso: 'SSO', cli: 'CLI', cms: 'CMS', pos: 'POS', crm: 'CRM', kyc: 'KYC', uat: 'UAT', v2: 'v2', esim: 'eSIM', qa: 'QA' })[word] ?? cap(word))
+		.join(' ');
+const platformOf = (company: Company, base: string, suffix: string, h: number) => {
+	if (h % 9 === 0) return '';
+	if (/mobile|app$|rider|driver|reader|player/.test(base) && ['', '-app', '-legacy', '-v2'].includes(suffix)) return h % 2 ? 'swift' : 'kotlin';
+	if (/web|website|portal|storefront|console|design-system|storybook|cms|admin|dashboards|kiosk/.test(base + suffix)) return 'javascript';
+	if (/cli|agent|collector|scanner/.test(base)) return 'go';
+	if (/firmware/.test(base)) return 'c';
+	return company.backend;
