+const LAST_MESSAGE = 50 * DAY + 17 * 60; // 20 November, 17:00
+const at = (minutes: number) => new Date(EPOCH + minutes * 60000);
+const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
+const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
+const weekday = (m: number) => dayNames[at(m).getUTCDay()]!;
+const clock = (m: number) => `${pad(at(m).getUTCHours())}:${pad(at(m).getUTCMinutes())}`;
+const dayMonth = (m: number) => `${at(m).getUTCDate()} ${monthNames[at(m).getUTCMonth()]}`;
+const shortDay = (m: number) => `${at(m).getUTCDate()} ${monthNames[at(m).getUTCMonth()]!.slice(0, 3)}`;
+const stampShort = (m: number) => `${weekday(m).slice(0, 3)} ${shortDay(m)}, ${clock(m)}`;
+const fullDate = (m: number) => `${shortDay(m)} ${at(m).getUTCFullYear()}`;
+const stampLong = (m: number) => `${weekday(m)} ${dayMonth(m)} 2026, ${clock(m)}`;
+const isoDay = (m: number) => at(m).toISOString().slice(0, 10);
+/** The last second written in the paste being built, so that each log runs forward in time. */
+let lastSecond = -Infinity;
+/** A second within minute `m`, never earlier than the line before it, as `[minute, second]`. */
+const tick = (m: number, r: Rand): [number, number] => {
+	lastSecond = Math.max(m * 60 + int(r, 0, 9), lastSecond + int(r, 1, 2));
+	return [Math.floor(lastSecond / 60), lastSecond % 60];
