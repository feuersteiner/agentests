+const projectsOf = (company: Company, count: number): Project[] => {
+	const h = hash(company.name);
+	const r = mulberry32(h);
+	const combos = shuffle(r, company.bases.flatMap((base) => suffixes.filter((suffix) => !base.split('-').includes(suffix.slice(1)) && !(base.endsWith('app') && suffix === '-web')).map((suffix) => [base, suffix] as const)));
