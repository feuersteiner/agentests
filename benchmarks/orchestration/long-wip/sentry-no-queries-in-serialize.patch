+	let minor = int(r, 0, 14);
+	let patch = int(r, 0, 3);
+	let released = EPOCH + (LAST_OPEN_DAY * DAY - int(r, 60, 6000)) * 60000;
+	const firstId = 40000 + (hash(project.slug + company.name) % 50000);
+	const rows: Release[] = [];
+	for (let i = 0; i < count; i++) {
+		rows.push({ id: firstId + count - i, version: `${major}.${minor}.${patch}`, released, by: `${pick(r, colleagues)} ${pick(r, surnames)}` });
+		released -= int(r, 2, 21) * 86400000 + int(r, 0, 86399) * 1000;
+		if (patch > 0 && r() < 0.6) patch--;
+		else if (minor > 0) {
+			minor--;
+			patch = r() < 0.7 ? 0 : int(r, 1, 2);
+		} else if (major > 0) {
+			major--;
+			minor = int(r, 3, 9);
+			patch = 0;
+		} else break;
+	}
+	return rows.filter((row) => row.released <= EPOCH + m * 60000);
+};
