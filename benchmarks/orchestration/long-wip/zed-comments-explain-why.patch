+		const spots = msgs.map((m, i) => i).filter((i) => msgs[i]!.who === 'req' && i < msgs.length - 1 && (msgs[i + 1]!.who === 'st' || msgs[i + 1]!.who === 'st2') && !msgs[i + 1]!.after);
+		const last = msgs.at(-1)!;
+		if (last.who === 'req' && (spots.length === 0 || chance(r, 0.3))) {
