+
+	// Times: the storage team answers within hours, requesters within a day or two, in working hours.
+	const schedule = (scale: number) => {
+		const rt = mulberry32(0x7a11 + index * 104729);
+		const times = [filed];
+		let at = filed;
+		for (let i = 1; i < msgs.length; i++) {
+			const m = msgs[i]!;
+			const prev = msgs[i - 1]!;
+			const gap = m.who === 'st' || m.who === 'st2' ? (prev.who === 'req' || prev.who === 'mate' ? int(rt, 12, 320) : int(rt, 30, 900)) : m.who === 'req' ? int(rt, 20, 2200) : int(rt, 60, 3000);
+			at += gap * MIN * scale;
+			if (m.after && at < m.after) at = m.after + int(rt, 5, 200) * MIN;
+			at = working(rt, at);
+			times.push(at);
+		}
+		return times;
+	};
+	let times = schedule(1);
+	for (const scale of [0.5, 0.25, 0.1]) if (times.at(-1)! > EXPORT - 14 * HOUR) times = schedule(scale);
+	if (times.at(-1)! > EXPORT - 14 * HOUR) throw new Error(`request ${index} (${topic.id}) runs past the export`);
+
+	const number = 140 + Math.floor((index * 5) / 4);
+	const name = (who: Who, m: Msg) => (who === 'req' ? s.req : who === 'mate' ? s.mate : who === 'st' ? `${s.st} (storage)` : who === 'st2' ? `${s.st2} (storage)` : `${m.ext![0]} (${m.ext![1]})`);
+	const kvField = pick(r, [s.kv, `v${s.kv}`, `${s.kv} (from Cargo.lock)`, s.kv, `not sure, whatever ${tl.name} ${s.tv} pins`]);
+	const watchers = [s.mate, ...(chance(r, 0.4) ? [s.st2] : [])];
