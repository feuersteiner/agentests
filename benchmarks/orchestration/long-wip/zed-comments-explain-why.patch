+	const out: string[] = [`# KV-${number}: ${title}`, ''];
+	out.push(
+		table(['Field', 'Value'], [
+			['Filed by', `${s.req}, ${team} team`],
+			['Tool', `${tl.name} ${s.tv}`],
+			['kvstore version', kvField],
+			['Runs on', runsOn(s)],
+			...(chance(r, 0.5) ? [['Priority as filed', pick(r, ['low', 'normal', 'normal', 'high'])]] : []),
+			['Filed', stamp(filed)],
+			['Assigned to', s.st],
+			['Watchers', watchers.join(', ')]
