+/** The end of a log whose last record was cut off mid-write, as the requester dumped it. */
+const cutLog = (s: S) => {
+	const r = s.r;
+	const whole: number[] = [];
+	for (let i = 0; i < 8; i++) {
+		const [k, v] = pick(r, s.tool.keys);
+		whole.push(...record(chance(r, 0.9) ? 1 : 2, k, chance(r, 0.9) ? v : ''));
+	}
+	const [k, v] = pick(r, s.tool.keys);
+	const value = v.length > 12 ? v.repeat(int(r, 2, 6)) : v;
+	const full = record(1, k, value);
+	const cut = pick(r, ['header', 'key', 'value', 'value']);
+	const present = cut === 'header' ? int(r, 2, 8) : cut === 'key' ? 9 + int(r, 1, k.length - 1) : 9 + k.length + int(r, 0, Math.max(0, value.length - 1));
+	const partial = full.slice(0, present);
+	const bytes = [...whole, ...partial];
+	const shown = Math.min(bytes.length, int(r, 6, 10) * 16 + int(r, 0, 15));
+	const tail = bytes.slice(bytes.length - shown);
+	const size = int(r, 30_000, 9_000_000);
+	const format = s.os === 'windows' ? 'xxd' : pick(r, ['xxd', 'hexdump']);
+	const command = s.os === 'windows' ? `${prompt(s)} wsl tail -c ${shown} kv.log | xxd` : format === 'xxd' ? `$ tail -c ${shown} kv.log | xxd` : `$ tail -c ${shown} kv.log | hexdump -C`;
+	const dump = fence('', `${command}\n${format === 'xxd' ? xxd(tail) : hexdumpC(tail)}`);
+	const at = shown - present;
+	let finding: string;
+	if (cut === 'header') finding = `The last ${present} bytes of your dump, from 0x${hex(at, 2)}, are the start of a record header: the set byte, 01, and part of the key's length. Nothing else of that record made it to the disk.`;
+	else finding = `The record that starts at 0x${hex(at, 2)} in your dump has the set byte (01), a key length of ${k.length} and a value length of ${value.length}, so it should be ${full.length} bytes long. Only ${present} bytes of it are there${cut === 'key' ? ', not even the whole key' : ''}.`;
+	const keep = size - present;
+	const fix =
+		s.os === 'windows'
+			? fence('powershell', `$f = [System.IO.File]::Open("${s.dir}\\kv.log", 'Open')\n$f.SetLength(${keep})\n$f.Close()`)
+			: s.os === 'mac'
+				? fence('', `python3 -c 'import os; os.truncate("kv.log", ${keep})'`)
+				: fence('', `truncate -s ${keep} kv.log`);
+	return { dump, size, present, keep, finding, fix, key: k };
+};
