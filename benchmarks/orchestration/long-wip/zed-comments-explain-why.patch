+// ---------------------------------------------------------------------------------------------------------
+// The log format, as kvstore writes it: one byte for the operation (1 set, 2 delete), the key's and the value's
+// lengths as little-endian u32s, then the key and the value.
+const utf8 = (text: string) => [...new TextEncoder().encode(text)];
+const le32 = (n: number) => [n & 255, (n >>> 8) & 255, (n >>> 16) & 255, (n >>> 24) & 255];
+const record = (op: number, key: number[] | string, value: number[] | string = []) => {
+	const k = typeof key === 'string' ? utf8(key) : key;
+	const v = typeof value === 'string' ? utf8(value) : value;
+	return [op, ...le32(k.length), ...le32(v.length), ...k, ...v];
+};
+const printable = (b: number) => (b >= 32 && b < 127 ? String.fromCharCode(b) : '.');
+const hexdumpC = (bytes: number[], base = 0) => {
+	const lines: string[] = [];
+	for (let i = 0; i < bytes.length; i += 16) {
+		const row = bytes.slice(i, i + 16);
+		const cells = row.map((b) => hex(b, 2));
+		const left = cells.slice(0, 8).join(' ');
+		const right = cells.slice(8).join(' ');
+		const hexPart = `${left.padEnd(23, ' ')}  ${right}`.padEnd(48, ' ');
+		lines.push(`${hex(base + i, 8)}  ${hexPart}  |${row.map(printable).join('')}|`);
+	}
+	lines.push(hex(base + bytes.length, 8));
+	return lines.join('\n');
+};
+const xxd = (bytes: number[], base = 0) => {
+	const lines: string[] = [];
+	for (let i = 0; i < bytes.length; i += 16) {
+		const row = bytes.slice(i, i + 16);
+		const groups: string[] = [];
+		for (let j = 0; j < row.length; j += 2) groups.push(row.slice(j, j + 2).map((b) => hex(b, 2)).join(''));
+		lines.push(`${hex(base + i, 8)}: ${groups.join(' ').padEnd(39, ' ')}  ${row.map(printable).join('')}`);
+	}
+	return lines.join('\n');
+};
+/** How strace prints a buffer: printable characters as they are, the rest as short octal escapes, cut at 32. */
+const straceBuf = (bytes: number[]) => {
+	let out = '';
+	bytes.slice(0, 32).forEach((b, i) => {
+		const next = bytes[i + 1];
+		if (b === 34) out += '\\"';
+		else if (b === 92) out += '\\\\';
+		else if (b >= 32 && b < 127) out += String.fromCharCode(b);
+		else if (b === 10) out += '\\n';
+		else out += next !== undefined && next >= 48 && next <= 55 ? `\\${b.toString(8).padStart(3, '0')}` : `\\${b.toString(8)}`;
+	});
+	return `"${out}"${bytes.length > 32 ? '...' : ''}`;
+};
