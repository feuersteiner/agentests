+const mulberry32 = (seed: number) => () => {
+	seed = (seed + 0x6d2b79f5) | 0;
+	let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+	t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+	return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+};
+type Rand = () => number;
+const int = (r: Rand, low: number, high: number) => low + Math.floor(r() * (high - low + 1));
+const pick = <T>(r: Rand, items: readonly T[]): T => items[Math.floor(r() * items.length)]!;
+const shuffle = <T>(r: Rand, items: readonly T[]): T[] => {
+	const copy = [...items];
+	for (let i = copy.length - 1; i > 0; i--) {
+		const j = Math.floor(r() * (i + 1));
+		[copy[i], copy[j]] = [copy[j]!, copy[i]!];
+	}
+	return copy;
+};
+const pad = (value: number) => String(value).padStart(2, '0');
+const money = (pounds: number) => `£${pounds.toFixed(2).replace(/\B(?=(\d{3})+\.)/g, ',')}`;
+/** Whole pounds without pence, as people write them in a chat. */
+const whole = (pounds: number) => (Number.isInteger(pounds) ? money(pounds).slice(0, -3) : money(pounds));
+const ordinal = (n: number) => `${n}${n % 10 === 1 && n !== 11 ? 'st' : n % 10 === 2 && n !== 12 ? 'nd' : n % 10 === 3 && n !== 13 ? 'rd' : 'th'}`;
+
+// Time is kept in minutes since 00:00 on 1 October 2026, UK local time.
+const EPOCH = Date.UTC(2026, 9, 1);
+const DAY = 1440;
+const at = (minutes: number) => new Date(EPOCH + minutes * 60000);
+const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
+const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
+const weekday = (m: number) => dayNames[at(m).getUTCDay()]!;
+const clock = (m: number) => `${pad(at(m).getUTCHours())}:${pad(at(m).getUTCMinutes())}`;
+const dayMonth = (m: number) => `${at(m).getUTCDate()} ${monthNames[at(m).getUTCMonth()]}`;
+const longDate = (m: number) => `${dayMonth(m)} ${at(m).getUTCFullYear()}`;
+const shortDate = (m: number) => `${at(m).getUTCDate()} ${monthNames[at(m).getUTCMonth()]!.slice(0, 3)} ${at(m).getUTCFullYear()}`;
+const stamp = (m: number) => `${weekday(m).slice(0, 3)} ${at(m).getUTCDate()} ${monthNames[at(m).getUTCMonth()]!.slice(0, 3)}, ${clock(m)}`;
+const iso = (m: number) => at(m).toISOString().slice(0, 10);
+const isoTime = (m: number, s: number) => `${iso(m)} ${clock(m)}:${pad(s)}`;
+const minuteOfDay = (m: number) => ((m % DAY) + DAY) % DAY;
+const startOfDay = (m: number) => m - minuteOfDay(m);
+const isWeekend = (m: number) => at(m).getUTCDay() % 6 === 0;
+/** Moves a time of night to the same day's early morning or the evening before, as people use their phones. */
+const daytime = (m: number) => (minuteOfDay(m) < 420 ? startOfDay(m) + 420 + (minuteOfDay(m) % 90) : minuteOfDay(m) > 1400 ? startOfDay(m) + 1300 + (minuteOfDay(m) % 60) : m);
+const addWorkdays = (m: number, n: number) => {
+	let x = m;
+	for (let i = 0; i < n; ) {
