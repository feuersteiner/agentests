+/** The working-day indices of an account's pay dates from September to December. */
+const paydays = (kind: string): number[] => {
+	const out: number[] = [];
+	const fridays = work.map((ms, i) => [ms, i] as const).filter(([ms]) => new Date(ms).getUTCDay() === 5);
+	if (kind === 'weekly' || kind === 'mixed') out.push(...fridays.map(([, i]) => i));
+	if (kind === 'fortnightly') out.push(...fridays.filter((_, n) => n % 2 === 1).map(([, i]) => i));
+	if (kind === 'fourweekly') out.push(...fridays.filter((_, n) => n % 4 === 2).map(([, i]) => i));
+	const dom = kind === 'm20' ? 20 : kind === 'm25' ? 25 : kind === 'm28' ? 28 : kind === 'm15' ? 15 : 0;
+	if (kind === 'last' || kind === 'mixed' || dom) {
+		for (let month = 8; month <= 11; month++) {
+			let target = dom ? Date.UTC(2026, month, dom) : Date.UTC(2026, month + 1, 0);
+			while (at(target) < 0) target -= DAY;
+			out.push(at(target));
+		}
+	}
+	return [...new Set(out)].sort((a, b) => a - b);
+};
