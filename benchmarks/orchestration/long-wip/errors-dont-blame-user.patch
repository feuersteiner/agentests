+// The calendar. Sign-ups run from Thursday 1 October to Friday 30 October 2026; notes stop on Tuesday 10 November.
+const DAY = 86_400_000;
+const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
+const work: number[] = [];
+for (let day = Date.UTC(2026, 8, 1); day <= Date.UTC(2026, 11, 31); day += DAY) {
+	const weekday = new Date(day).getUTCDay();
+	if (weekday !== 0 && weekday !== 6) work.push(day);
+}
+const at = (ms: number) => work.indexOf(ms);
+const FIRST = at(Date.UTC(2026, 9, 1));
+const LAST_SIGNUP = at(Date.UTC(2026, 9, 30));
+const END = at(Date.UTC(2026, 10, 10));
+const short = (i: number) => {
+	const d = new Date(work[i]!);
+	return `${WD[d.getUTCDay()]} ${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}`;
+};
+const plain = (i: number) => {
+	const d = new Date(work[i]!);
+	return `${['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][d.getUTCDay()]} ${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}`;
+};
+const monthOf = (i: number) => MONTHS[new Date(work[i]!).getUTCMonth()]!;
