+const mulberry32 = (seed: number) => () => {
+	seed = (seed + 0x6d2b79f5) | 0;
+	let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+	t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+	return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+};
+type Rand = () => number;
+const int = (r: Rand, low: number, high: number) => low + Math.floor(r() * (high - low + 1));
+const pick = <T>(r: Rand, items: readonly T[]): T => items[Math.floor(r() * items.length)]!;
+const shuffle = <T>(r: Rand, items: readonly T[]): T[] => {
+	const copy = [...items];
+	for (let i = copy.length - 1; i > 0; i--) {
+		const j = Math.floor(r() * (i + 1));
+		[copy[i], copy[j]] = [copy[j]!, copy[i]!];
+	}
+	return copy;
+};
+/** A stable number for a name, so that a customer keeps its people, size and terms from case to case. */
+const hash = (text: string) => [...text].reduce((h, c) => Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0, 2166136261);
+const pad = (value: number, width = 2) => String(value).padStart(width, '0');
+const usd = (amount: number) => {
+	const [whole, cents] = (Math.round(amount * 100) / 100).toFixed(2).split('.');
+	return `$${whole!.replace(/\B(?=(\d{3})+$)/g, ',')}.${cents}`;
+};
+const round = (amount: number, step: number) => Math.round(amount / step) * step;
+const plain = (text: string) => text.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ø/g, 'o').replace(/ł/g, 'l').replace(/ß/g, 'ss').toLowerCase();
+const ordinal = (n: number) => `${n}${n % 10 === 1 && n !== 11 ? 'st' : n % 10 === 2 && n !== 12 ? 'nd' : n % 10 === 3 && n !== 13 ? 'rd' : 'th'}`;
