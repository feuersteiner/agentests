+		const kind = prof(c).quarterly ? 'quarterly' : 'annual';
+		if (!topic.kinds.includes(kind) || (kind === 'annual' && annual.has(c))) return undefined;
+		return kind;
+	};
+	const fits = shuffle(order, customers).filter((c) => (topic.fit ?? ((x: Customer) => !x.card))(c) && kindFor(c));
+	const fewest = Math.min(...fits.map((c) => usedCustomer.get(c) ?? 0));
+	const customer = fits.find((c) => (usedCustomer.get(c) ?? 0) === fewest)!;
+	usedCustomer.set(customer, fewest + 1);
+	const plan = { topic, path, open, customer, kind: kindFor(customer)! };
+	if (plan.kind === 'annual') annual.set(customer, plan);
+	plans.push(plan);
+}
+/** A customer's contract year starts in the month its annual invoice covers from, or in a month of its own. */
+const anniversaryOf = (c: Customer) => {
+	const plan = annual.get(c);
+	if (!plan) return hash(c.name + 'year') % 12;
+	return at(nextMonthStart(timing(plan, billingTerms(plan)).issued)).getUTCMonth();
+};
+
+const folder = join(root, 'billing', 'cases');
+mkdirSync(folder, { recursive: true });
+let number = 2103;
+plans.forEach((plan, index) => {
+	number += int(order, 1, 3);
+	writeFileSync(join(folder, `case-${number}.md`), caseFile(index, plan, number, anniversaryOf(plan.customer)));
+});
+writeFileSync(
+	join(folder, 'README.md'),
+	`# Collections cases, March to July 2026\n\nThe cases the billing inbox opened between 2 March and 31 July 2026, one file each, exported from the old billing\ntool before the switch. A case opens on its own when an invoice is a week past due, and holds the emails with the\ncustomer, the internal notes and anything the billing system logged. The export kept the messages but not the reason\ncodes, statuses or owners. Numbers missing from the sequence were test cases or were merged into another case.\nTimes are US Eastern.\n`
+);
