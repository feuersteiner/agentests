+	if (minuteOfDay(m) > to) m = startOfDay(m) + DAY + from + int(r, 0, 150);
+	if (minuteOfDay(m) < from) m = startOfDay(m) + from + int(r, 0, 150);
+	while (at(m).getUTCDay() % 6 === 0) m += DAY;
+	return m;
+};
