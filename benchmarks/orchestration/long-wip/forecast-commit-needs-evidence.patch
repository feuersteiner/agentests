+const stampLong = (m: number) => `${weekday(m)} ${dateLong(m)}, ${clock(m)}`;
+const minuteOfDay = (m: number) => ((m % DAY) + DAY) % DAY;
+const startOfDay = (m: number) => m - minuteOfDay(m);
+const dayIndex = (m: number) => Math.floor(m / DAY);
+const isWorkday = (m: number) => at(m).getUTCDay() % 6 !== 0 && !HOLIDAYS.has(dayIndex(m));
