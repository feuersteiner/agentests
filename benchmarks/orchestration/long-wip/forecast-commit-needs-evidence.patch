+/** Keeps a message from Corvid inside its office hours: 08:30 to 17:30 Eastern on working days. */
+const office = (r: Rand, t: number) => {
+	let m = t;
+	if (minuteOfDay(m) > 17 * 60 + 15) m = startOfDay(m) + DAY + 8 * 60 + 30 + int(r, 0, 100);
+	if (minuteOfDay(m) < 8 * 60 + 30) m = startOfDay(m) + 8 * 60 + 30 + int(r, 0, 100);
+	while (!isWorkday(m)) m += DAY;
+	return m;
+};
+/** Customers write in their own working day: 07:30 to 18:30 in North America, 02:30 to 12:00 Eastern from Europe. */
