+// Time is kept in minutes since 00:00 on 1 September 2026, UK local time.
+const EPOCH = Date.UTC(2026, 8, 1);
+const FIRST_OPEN = 1 * 1440 + 8 * 60; // 2 September
+const LAST_OPEN = 73 * 1440 + 16 * 60; // 13 November, 16:00
+const LAST_MESSAGE = 80 * 1440 + 17 * 60; // 20 November, 17:00
+const at = (minutes: number) => new Date(EPOCH + minutes * 60000);
+const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
+const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
+const weekday = (minutes: number) => dayNames[at(minutes).getUTCDay()]!;
+const clock = (minutes: number) => `${pad(at(minutes).getUTCHours())}:${pad(at(minutes).getUTCMinutes())}`;
+const shortDate = (minutes: number) => `${at(minutes).getUTCDate()} ${monthNames[at(minutes).getUTCMonth()]!.slice(0, 3)} ${at(minutes).getUTCFullYear()}`;
+const longDate = (minutes: number) => `${at(minutes).getUTCDate()} ${monthNames[at(minutes).getUTCMonth()]!} ${at(minutes).getUTCFullYear()}`;
+const stampShort = (minutes: number) => `${weekday(minutes).slice(0, 3)} ${at(minutes).getUTCDate()} ${monthNames[at(minutes).getUTCMonth()]!.slice(0, 3)}, ${clock(minutes)}`;
+const stampLong = (minutes: number) => `${weekday(minutes)} ${longDate(minutes)}, ${clock(minutes)}`;
+const isWeekend = (minutes: number) => at(minutes).getUTCDay() % 6 === 0;
+const minuteOfDay = (minutes: number) => ((minutes % 1440) + 1440) % 1440;
+const startOfDay = (minutes: number) => minutes - minuteOfDay(minutes);
+
+/** When support answers: some time after `t`, inside office hours, Monday to Friday. */
+const office = (r: Rand, t: number, low = 35, high = 540) => {
+	let m = t + int(r, low, high);
+	for (let guard = 0; guard < 20; guard++) {
+		const d = minuteOfDay(m);
+		if (isWeekend(m)) m = startOfDay(m) + 1440 + 8 * 60 + 40 + int(r, 0, 120);
+		else if (d < 8 * 60 + 40) m = startOfDay(m) + 8 * 60 + 40 + int(r, 0, 140);
+		else if (d > 17 * 60 + 25) m = startOfDay(m) + 1440 + 8 * 60 + 40 + int(r, 0, 140);
+		else return m;
+	}
+	return m;
+};
+/** When a customer writes back: some time after `t`, between 07:00 and 23:00, any day. */
+const waking = (r: Rand, t: number, low = 25, high = 1500) => {
+	let m = t + int(r, low, high);
+	const d = minuteOfDay(m);
+	if (d < 7 * 60) m = startOfDay(m) + 7 * 60 + int(r, 0, 150);
+	else if (d > 23 * 60) m = startOfDay(m) + 1440 + 7 * 60 + int(r, 0, 150);
+	return m;
+};
+/** A weekday a few working days after `t`, by name. */
+const workingDayAfter = (t: number, days: number) => {
+	let m = startOfDay(t);
+	let left = days;
+	while (left > 0) {
+		m += 1440;
+		if (!isWeekend(m)) left--;
+	}
+	return weekday(m);
+};
